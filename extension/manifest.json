{
  "manifest_version": 3,
  "name": "Pippin",
  "version": "0.1.0",
  "description": "Your research assistant where you read: save anything into your notebook, see how a paper relates to your questions, follow people and threads.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Pippin"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://openreview.net/forum*",
        "https://aclanthology.org/*",
        "https://www.semanticscholar.org/paper/*",
        "https://doi.org/*"
      ],
      "js": [
        "paper.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*"
      ],
      "js": [
        "overleaf.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this page (or the selection) to Pippin"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      }
    },
    "cite-sentence": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Find a citation for this sentence (Overleaf)"
    }
  }
}